generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  mediaUrl  String
  mediaType String   @default("image") // "image" | "video"
  ctaText   String?
  ctaLink   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  shortDesc   String
  description String   @db.Text
  image       String
  icon        String?
  benefits    String[] 
  duration    String?
  price       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Location {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  city      String
  state     String
  address   String   @db.Text
  phone     String
  email     String?
  mapUrl    String?  @db.Text
  image     String?
  timings   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @db.Text
  content     String    @db.Text
  coverImage  String
  category    String
  author      String
  tags        String[]
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  seoTitle       String?
  seoDescription String?
  noIndex        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Admin-managed content pages (privacy policy, terms, guides...) served at /pages/[slug]
model Page {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  summary        String?
  content        String   @db.Text // plain paragraphs or HTML, rendered by RichContent
  heroImage      String?
  seoTitle       String?
  seoDescription String?
  noIndex        Boolean  @default(false)
  showInFooter   Boolean  @default(false)
  sortOrder      Int      @default(0)
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  location  String
  rating    Int      @default(5)
  text      String   @db.Text
  image     String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FranchiseInquiry {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String
  city         String
  state        String
  investment   String?
  message      String?  @db.Text
  status       String   @default("new") // "new" | "contacted" | "approved" | "rejected"
  notes        String?  @db.Text // internal, admin only
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Session booking requests from the website contact form
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  city      String?
  interest  String? // therapy asked for
  subject   String
  message   String   @db.Text
  status    String   @default("new") // "new" | "contacted" | "booked" | "closed"
  notes     String?  @db.Text // internal, admin only
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String?
  mediaUrl  String
  mediaType String   @default("image") // "image" | "video"
  section   String   @default("general") // "general" | "services" | "locations" | "about"
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?  @db.Text
  image     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String   @default("general")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

// Home page "Benefits of reflexology" list
model Benefit {
  id          String   @id @default(cuid())
  title       String
  description String?
  icon        String   @default("leaf") // key from BENEFIT_ICONS in src/components/BenefitsSection.tsx
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Home page "Social highlights": YouTube or Instagram links
model SocialVideo {
  id         String   @id @default(cuid())
  url        String
  title      String
  coverImage String?
  views      String?
  likes      String?
  comments   String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
